# Environment Variables Example for Smart Legal Assistant Backend

# Server Port
PORT=8080

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/smart_legal_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# JPA / Hibernate
DDL_AUTO=update
SHOW_SQL=true

# JWT Authentication
# Secret key should be a base64 encoded strong secret string (at least 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiration time in milliseconds (e.g., 86400000 ms = 24 hours)
JWT_EXPIRATION=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
